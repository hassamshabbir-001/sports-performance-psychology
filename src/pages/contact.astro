---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact Sports Performance Psychology"
  description="Contact Sports Performance Psychology with questions, feedback, or topic suggestions."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="breadcrumbs"><a href="/">Home</a> / Contact</p>
      <h1>Contact Us</h1>
      <p>Questions, feedback, or topic suggestions? We would like to hear from you.</p>
    </div>
  </section>
  <section class="page-body">
    <div class="wrap">
      <p>Send your message to <a href="mailto:info@sportsperformancepsychology.com">info@sportsperformancepsychology.com</a> and we will get back to you as soon as we can. For topic ideas, tell us what you are an athlete, coach, parent, or student working on, and we will consider it for a future guide.</p>
    </div>
  </section>
</BaseLayout>
