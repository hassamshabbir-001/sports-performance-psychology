---
import BaseLayout from '../layouts/BaseLayout.astro';
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://sportsperformancepsychology.com/cookies/#webpage",
      "url": "https://sportsperformancepsychology.com/cookies/",
      "name": "Cookie Policy for Sports Performance Psychology Site",
      "description": "Cookie policy for Sports Performance Psychology: what cookies are, what this site uses, and how to control them.",
      "isPartOf": {
        "@id": "https://sportsperformancepsychology.com/#website"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sportsperformancepsychology.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Cookie Policy",
          "item": "https://sportsperformancepsychology.com/cookies/"
        }
      ]
    }
  ]
};
---
<BaseLayout
  title="Cookie Policy for Sports Performance Psychology Site"
  description="Cookie policy for Sports Performance Psychology: what cookies are, what this site uses, and how to control them. Last updated November 2026."
>
  <article>
  <section class="page-hero">
    <div class="wrap">
      <p class="breadcrumbs"><a href="/">Home</a> / Cookie Policy</p>
      <h1>Cookie Policy</h1>
      <p>What cookies are, what this site uses, and how to control them. Last updated: November 2026.</p>
    </div>
  </section>
  <section class="page-body">
    <div class="wrap">
      <div class="prose">
        <h2>What Cookies Are</h2>
        <p>Cookies are small text files that websites store on your device. They help sites remember your preferences, keep you signed in, and understand how visitors use the site. Most browsers accept cookies by default.</p>
        <h2>What This Site Uses</h2>
        <p>We keep cookie use to a minimum:</p>
        <ul>
          <li><strong>Strictly necessary cookies:</strong> required for basic site functions such as remembering your cookie preferences. These cannot be switched off without breaking parts of the site.</li>
          <li><strong>Analytics cookies:</strong> if enabled, these collect anonymized information about how visitors use the site (for example, which pages are popular). They do not identify you personally.</li>
          <li><strong>Advertising cookies:</strong> if the site displays ads in the future, our advertising partners may set cookies to show relevant ads and measure their performance. See our <a href="/disclaimer/">Disclaimer</a> for our advertising disclosure.</li>
        </ul>
        <h2>How to Control Cookies</h2>
        <p>You can control or delete cookies through your browser settings. Every major browser lets you block third-party cookies, delete existing cookies, or browse in a private mode that discards cookies when you close the window. Blocking strictly necessary cookies may affect how the site works.</p>
        <h2>More Information</h2>
        <p>If you have questions about how we use cookies, write to <a href="mailto:info@sportsperformancepsychology.com">info@sportsperformancepsychology.com</a>. You can also read our <a href="/privacy-policy/">Privacy Policy</a> for the broader picture of how we handle information.</p>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </article>
</BaseLayout>
