---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Privacy Policy | Sports Performance Psychology"
  description="Privacy policy for Sports Performance Psychology: how we collect, use, and protect your information."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="breadcrumbs"><a href="/">Home</a> / Privacy Policy</p>
      <h1>Privacy Policy</h1>
      <p>How we collect, use, and protect your information.</p>
    </div>
  </section>
  <section class="page-body">
    <div class="wrap">
      <p>We collect minimal information: if you join our email list, we store your email address to send you updates. We do not sell your personal information. Analytics tools we use may collect anonymized usage data to help us improve the site.</p>
      <p>You can unsubscribe from emails at any time using the link in any message, or by writing to <a href="mailto:hello@sportsperformancepsychology.com">hello@sportsperformancepsychology.com</a>. This policy may be updated as the site grows; the latest version will always be posted here.</p>
    </div>
  </section>
</BaseLayout>
