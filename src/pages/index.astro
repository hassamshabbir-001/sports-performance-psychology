---
import BaseLayout from '../layouts/BaseLayout.astro';

const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---
<BaseLayout
  title="Sports Performance Psychology: Mental Skills, Degrees and Careers"
  description="Evidence-based insights on sports psychology, mental skills, degrees, and careers. Learn how athletes build focus, confidence, and consistency."
  ogImage="/images/athlete-mental-preparation.webp"
>

  <!-- 1. Hero -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Sports Performance Psychology</p>
        <h1>The Mental Side of <span class="accent">Athletic Performance</span></h1>
        <p class="lead">Evidence-based insights on sports psychology, mental skills, degrees, careers, and how athletes build focus, confidence, and consistency.</p>
        <div class="hero-ctas">
          <a class="btn btn-red" href="/what-is-sports-psychology/">Explore the Basics <Fragment set:html={arrow} /></a>
          <a class="btn btn-outline" href="/degrees/">Browse Degrees</a>
        </div>
      </div>
    </div>
    <div class="hero-media" aria-hidden="true">
      <img class="photo" src="/images/athlete-mental-preparation.webp" alt="" width="1408" height="704" fetchpriority="high" />
      <svg class="hero-curve" viewBox="0 0 500 600" preserveAspectRatio="none">
        <path d="M100,0 C42,150 42,450 100,600" fill="none" stroke="#D62828" stroke-width="10"/>
      </svg>
    </div>
  </section>

  <!-- 2. Quick-link strip -->
  <div class="quick-strip">
    <div class="wrap">
      <div class="quick-grid">
        <a class="quick-item" href="/mental-skills/">
          <svg viewBox="0 0 24 24" fill="none" stroke="#D62828" stroke-width="1.8" aria-hidden="true"><path d="M9.5 3A5.5 5.5 0 0 0 4 8.5c-1.6.8-2.5 2.4-2 4 .1 2 1.6 3.2 2 5 .3 1.6 1.7 2.8 3.4 2.9.6 1 1.7 1.6 2.9 1.6h1.4c1.2 0 2.3-.6 2.9-1.6 1.7-.1 3.1-1.3 3.4-2.9.4-1.8 1.9-3 2-5 .5-1.6-.4-3.2-2-4A5.5 5.5 0 0 0 14.5 3 5.5 5.5 0 0 0 12 4.2 5.5 5.5 0 0 0 9.5 3z"/><path d="M12 4.5v16"/></svg>
          <span>Mental Skills for Performance</span>
        </a>
        <a class="quick-item" href="/degrees/">
          <svg viewBox="0 0 24 24" fill="none" stroke="#D62828" stroke-width="1.8" aria-hidden="true"><path d="M2 9l10-5 10 5-10 5L2 9z"/><path d="M6 11.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.5"/><path d="M22 9v5"/></svg>
          <span>Degrees &amp; Programs</span>
        </a>
        <a class="quick-item" href="/careers/">
          <svg viewBox="0 0 24 24" fill="none" stroke="#D62828" stroke-width="1.8" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18"/></svg>
          <span>Careers &amp; Job Opportunities</span>
        </a>
        <a class="quick-item" href="/careers/">
          <svg viewBox="0 0 24 24" fill="none" stroke="#D62828" stroke-width="1.8" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-8M21 20H3"/></svg>
          <span>Salary &amp; Field Outlook</span>
        </a>
      </div>
    </div>
  </div>

  <!-- 3. Explore Key Topics -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Explore Key Topics</h2>
        <p>Learn, grow, and build your knowledge in sports performance psychology.</p>
      </div>
      <div class="card-grid">
        <article class="card">
          <img src="/images/training-plan-equipment.webp" alt="Training plan, notebook, and coaching equipment on a field" width="1408" height="704" loading="lazy" />
          <div class="card-body">
            <h3>Degrees</h3>
            <p>Explore bachelor's, master's, and PhD programs, online options, and certification paths in sports psychology.</p>
            <a class="card-link" href="/degrees/">Explore Degrees <Fragment set:html={arrow} /></a>
          </div>
        </article>
        <article class="card">
          <img src="/images/team-communication-soccer.webp" alt="Soccer team talking together on the field" width="1408" height="704" loading="lazy" />
          <div class="card-body">
            <h3>Careers</h3>
            <p>Learn about sports psychology jobs, work settings, salary ranges, and long-term career opportunities.</p>
            <a class="card-link" href="/careers/">Explore Careers <Fragment set:html={arrow} /></a>
          </div>
        </article>
        <article class="card">
          <img src="/images/basketball-focus-routine.webp" alt="Basketball player focused before a shot" width="1408" height="704" loading="lazy" />
          <div class="card-body">
            <h3>Mental Skills</h3>
            <p>Practical techniques like visualization, self-talk, routines, focus, and mental toughness to improve performance.</p>
            <a class="card-link" href="/mental-skills/">Explore Mental Skills <Fragment set:html={arrow} /></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. Pillar banner -->
  <section class="pillar-banner">
    <div class="wrap">
      <div class="pillar-grid">
        <div class="pillar-media">
          <img src="/images/athlete-preparation-track.webp" alt="Athlete warming up on a track at sunrise" width="1408" height="704" loading="lazy" />
        </div>
        <div class="pillar-copy">
          <p class="eyebrow">New Here?</p>
          <h2>What Is Sports Psychology?</h2>
          <p>Get a clear, practical overview of sports psychology, what it is, what sports psychologists do, and the key mental skills used in sports.</p>
          <a class="btn btn-red" href="/what-is-sports-psychology/">Read the Guide <Fragment set:html={arrow} /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Popular Articles -->
  <section class="section soft">
    <div class="wrap">
      <div class="section-head">
        <h2>Popular Articles</h2>
        <p>Start with these in-depth guides to the most common sports psychology topics.</p>
      </div>
      <div class="card-grid four">
        <article class="card">
          <img src="/images/training-plan-equipment.webp" alt="Training plan and coaching equipment" width="1408" height="704" loading="lazy" />
          <div class="card-body">
            <h3>Sports Psychology Degree</h3>
            <p>A complete guide to sports psychology degrees, including what you will study, program options, and how to choose the right path.</p>
            <a class="card-link" href="/degrees/">Read More <Fragment set:html={arrow} /></a>
          </div>
        </article>
        <article class="card">
          <img src="/images/athlete-mental-preparation.webp" alt="Athlete focusing in the gym" width="1408" height="704" loading="lazy" />
          <div class="card-body">
            <h3>Sports Psychology Salary</h3>
            <p>Learn how much sports psychologists earn, what affects salary, and how pay can vary by setting, education, and experience.</p>
            <a class="card-link" href="/careers/">Read More <Fragment set:html={arrow} /></a>
          </div>
        </article>
        <article class="card">
          <img src="/images/team-communication-soccer.webp" alt="Soccer team in discussion on the field" width="1408" height="704" loading="lazy" />
          <div class="card-body">
            <h3>Sports Psychology Jobs</h3>
            <p>Explore the most common sports psychology jobs, from working with athletes to roles in coaching, performance, and academic settings.</p>
            <a class="card-link" href="/careers/">Read More <Fragment set:html={arrow} /></a>
          </div>
        </article>
        <article class="card">
          <img src="/images/basketball-focus-routine.webp" alt="Basketball player in a pre-shot routine" width="1408" height="704" loading="lazy" />
          <div class="card-body">
            <h3>Visualization in Sports Psychology</h3>
            <p>Learn how visualization works, why it is effective, and how athletes use it to build confidence, improve focus, and perform under pressure.</p>
            <a class="card-link" href="/mental-skills/">Read More <Fragment set:html={arrow} /></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 6. Mental Skills Athletes Use -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Mental Skills Athletes Use</h2>
        <p>Key mental skills that help athletes stay focused, confident, and perform at their best.</p>
      </div>
      <div class="tile-grid">
        <div class="tile">
          <svg viewBox="0 0 24 24" fill="none" stroke="#D62828" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="M21 16l-5-5-6 6"/></svg>
          <div><h3>Visualization</h3><p>Mentally rehearse performance to build confidence and preparation.</p></div>
        </div>
        <div class="tile">
          <svg viewBox="0 0 24 24" fill="none" stroke="#D62828" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="#D62828"/></svg>
          <div><h3>Focus</h3><p>Keep your attention on what matters, even under pressure.</p></div>
        </div>
        <div class="tile">
          <svg viewBox="0 0 24 24" fill="none" stroke="#D62828" stroke-width="1.8" aria-hidden="true"><path d="M21 12a8 8 0 0 1-8 8H4l2-3a8 8 0 1 1 15-5z"/></svg>
          <div><h3>Self-Talk</h3><p>Use positive, constructive thoughts to stay confident and resilient.</p></div>
        </div>
        <div class="tile">
          <svg viewBox="0 0 24 24" fill="none" stroke="#D62828" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4M9 15l2 2 4-4"/></svg>
          <div><h3>Routines</h3><p>Build consistent habits to prepare your mind and perform more reliably.</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Degrees and Careers Path -->
  <section class="section soft">
    <div class="wrap">
      <div class="section-head">
        <h2>Degrees and Careers Path</h2>
        <p>A clear look at educational options and career opportunities in sports psychology.</p>
      </div>
      <div class="panel-grid">
        <div class="panel">
          <img src="/images/training-plan-equipment.webp" alt="Coaching notebook, whistle, and training equipment" width="1408" height="704" loading="lazy" />
          <div class="panel-body">
            <h3>Degrees &amp; Programs</h3>
            <p>Explore degree options in sports psychology, from bachelor's to master's and PhD programs, including online and on-campus choices.</p>
            <a class="card-link" href="/degrees/">Explore Degree Options <Fragment set:html={arrow} /></a>
          </div>
        </div>
        <div class="panel">
          <img src="/images/team-communication-soccer.webp" alt="Sports psychology professional talking with athletes" width="1408" height="704" loading="lazy" />
          <div class="panel-body">
            <h3>Careers &amp; Salary</h3>
            <p>Learn about sports psychology career paths, where professionals work, and what you can expect in terms of salary and job outlook.</p>
            <a class="card-link" href="/careers/">Explore Careers &amp; Salary <Fragment set:html={arrow} /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Subscribe band -->
  <section class="subscribe">
    <div class="wrap">
      <div class="subscribe-grid">
        <div class="subscribe-media">
          <img src="/images/runner-flexibility-warmup.webp" alt="Runner stretching on a track at sunset" width="1408" height="704" loading="lazy" />
        </div>
        <div class="subscribe-copy">
          <h2>Get Sports Psychology Guides and Updates</h2>
          <p>Join our email list for new articles, in-depth guides, and practical resources on sports performance psychology.</p>
          <form class="subscribe-form" action="#" method="post">
            <input type="email" name="email" placeholder="Enter your email address" aria-label="Email address" required />
            <button class="btn btn-red" type="submit">Subscribe <Fragment set:html={arrow} /></button>
          </form>
          <p class="subscribe-note">Thanks for subscribing. You are on the list.</p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
