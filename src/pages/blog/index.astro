---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../data/articles';

const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';

// Newest articles first; this page updates automatically when articles.ts grows.
const sorted = [...articles].sort((a, b) => b.date.localeCompare(a.date));

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://sportsperformancepsychology.com/blog/#webpage",
      "url": "https://sportsperformancepsychology.com/blog/",
      "name": "Blog: Sports Psychology Articles and Guides",
      "description": "In-depth articles and guides on sports psychology: mental skills, degrees, careers, salary, and performance techniques for athletes.",
      "isPartOf": { "@id": "https://sportsperformancepsychology.com/#website" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sportsperformancepsychology.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://sportsperformancepsychology.com/blog/" }
      ]
    }
  ]
};
---
<BaseLayout
  title="Sports Psychology Blog: Articles, Guides & Research"
  description="In-depth articles and guides on sports psychology: mental skills, degrees, careers, salary, and performance techniques for athletes."
  ogImage="/images/athlete-preparation-track.webp"
>
  <article>
  <!-- Inner hero -->
  <section class="inner-hero">
    <div class="wrap inner-hero-grid">
      <div class="inner-hero-copy">
        <p class="crumbs"><a href="/">Home</a> &rsaquo; Blog</p>
        <h1>Blog</h1>
        <p class="lead">In-depth articles and practical guides on sports psychology: mental skills, degrees, careers, and performance techniques for athletes.</p>
      </div>
    </div>
  </section>

  {sorted.length > 0 ? (
    <section class="section">
      <div class="wrap">
        <div class="card-grid four">
          {sorted.map((a) => (
            <article class="card">
              <img src={a.image} alt={a.alt} width={a.width ?? 1200} height={a.height ?? 675} loading="lazy" />
              <div class="card-body">
                <h2>{a.title}</h2>
                <p>{a.excerpt}</p>
                <a class="card-link" href={a.href}>Read More <Fragment set:html={arrow} /></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <section class="section">
      <div class="wrap">
        <div class="prose" style="text-align: center;">
          <h2>In-depth articles are on the way</h2>
          <p>We are preparing practical, evidence-based articles on sports psychology. While you wait, explore our core guides:</p>
          <div class="explore-links">
            <a href="/degrees/">Sports Psychology Degrees <Fragment set:html={arrow} /></a>
            <a href="/careers/">Careers in Sports Psychology <Fragment set:html={arrow} /></a>
            <a href="/mental-skills/">Mental Skills Training <Fragment set:html={arrow} /></a>
          </div>
        </div>
      </div>
    </section>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </article>
</BaseLayout>
