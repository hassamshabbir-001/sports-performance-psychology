<BaseLayout
  title="Hassam Shabbir, Author | Sports Performance Psychology"
  description="Meet Hassam Shabbir, the writer behind Sports Performance Psychology: his background in psychology, research, and why he built this site."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="breadcrumbs"><a href="/">Home</a> / Author</p>
      <div class="author-head">
        <div class="author-monogram" aria-hidden="true">HS</div>
