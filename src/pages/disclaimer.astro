---
import BaseLayout from '../layouts/BaseLayout.astro';
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://sportsperformancepsychology.com/disclaimer/#webpage",
      "url": "https://sportsperformancepsychology.com/disclaimer/",
      "name": "Disclaimer for Sports Performance Psychology Website",
      "description": "Disclaimer for Sports Performance Psychology: educational content, no professional advice, and advertising disclosure.",
      "isPartOf": {
        "@id": "https://sportsperformancepsychology.com/#website"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://sportsperformancepsychology.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Disclaimer",
          "item": "https://sportsperformancepsychology.com/disclaimer/"
        }
      ]
    }
  ]
};
---
<BaseLayout
  title="Disclaimer for Sports Performance Psychology Website"
  description="Disclaimer for Sports Performance Psychology: educational content, no professional advice, and advertising disclosure. Last updated November 2026."
>
  <article>
  <section class="page-hero">
    <div class="wrap">
      <p class="breadcrumbs"><a href="/">Home</a> / Disclaimer</p>
      <h1>Disclaimer</h1>
      <p>Please read this before relying on anything you find here. Last updated: November 2026.</p>
    </div>
  </section>
  <section class="page-body">
    <div class="wrap">
      <div class="prose">
        <h2>Educational Purposes Only</h2>
        <p>Everything on this site is published for educational purposes only. Articles about mental skills, training techniques, degrees, careers, and salaries are general information, not advice tailored to your situation.</p>
        <h2>Not Professional Advice</h2>
        <p>Content on this site is not a substitute for professional medical or psychological advice, diagnosis, or treatment. Mental performance techniques described here are intended for healthy athletes and performers working on skills like focus and confidence. If you are dealing with anxiety, depression, an eating disorder, or any mental health concern, please work with a licensed mental health professional. Never disregard professional advice because of something you read on this site.</p>
        <h2>Figures and Program Details Change</h2>
        <p>Salary figures, tuition costs, certification fees, and program requirements change over time and vary by school, employer, and location. We name our sources and check them regularly, but you should always confirm current details with the original source (the school, employer, or certifying body) before making decisions.</p>
        <h2>No Guarantees</h2>
        <p>We make no guarantees about outcomes. A technique that helps one athlete may not help another, and salary ranges describe reported data, not promises about what you will earn.</p>
        <h2>Advertising Disclosure</h2>
        <p>This site may display advertisements served by third-party networks. We do not control the content of those ads, and an ad appearing on the site is not an endorsement of the advertised product or service.</p>
        <h2>External Links</h2>
        <p>We link to external sites we consider useful and reputable. We are not responsible for the content, accuracy, or privacy practices of external websites.</p>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </article>
</BaseLayout>
