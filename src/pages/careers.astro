---
import BaseLayout from '../layouts/BaseLayout.astro';

const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const briefIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="#D62828" stroke-width="1.8" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18"/></svg>';
const chartIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="#D62828" stroke-width="1.8" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-8M21 20H3"/></svg>';
const trendIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="#D62828" stroke-width="1.8" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/></svg>';
const usersIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="#D62828" stroke-width="1.8" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><circle cx="17" cy="9" r="2.5"/><path d="M16 14.2c2.8.3 5.5 2.2 5.5 5.8"/></svg>';
const bookIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="#D62828" stroke-width="1.8" aria-hidden="true"><path d="M12 6c-2-1.5-5-2-8-2v14c3 0 6 .5 8 2 2-1.5 5-2 8-2V4c-3 0-6 .5-8 2z"/><path d="M12 6v14"/></svg>';

const faqs = [
  {
    q: "What does a sports psychologist do?",
    a: "Sports psychologists help athletes and performers improve the mental side of performance. Typical work includes teaching skills such as goal setting, visualization, self-talk, and arousal regulation; helping athletes recover confidence after injury or poor performance; supporting coaches with team communication; and, for licensed practitioners, addressing mental health concerns that affect performance."
  },
  {
    q: "How much do sports psychologists make?",
    a: "Pay varies widely by role, setting, education, and location. ZipRecruiter reported an average of $92,813 per year in October 2026, with a typical range of $66,500 to $117,000 and top earners above $146,000. Payscale reported a lower average near $75,000, with a range of $49,000 to $103,000. Private consultants working with elite athletes can earn more, while entry-level and academic roles often pay less. Treat any single figure as an estimate, not a guarantee."
  },
  {
    q: "What is the job outlook for sports psychology?",
    a: "Demand for mental performance support has grown steadily as teams, colleges, and academies invest more in athlete wellbeing and performance staff. The US Bureau of Labor Statistics does not publish separate employment projections for sport psychologists, so outlook claims should be read carefully. Roles tend to concentrate in collegiate athletics, professional sport organizations, private consulting, and academia."
  },
  {
    q: "Where do sports psychologists work?",
    a: "Common work settings include college and university athletic departments, professional and Olympic sport organizations, youth sport academies, private consulting practices, hospitals and rehabilitation clinics, the military's performance programs, and academic or research institutions. Many practitioners combine settings, for example consulting with teams while teaching part time."
  },
  {
    q: "Do I need a license to practice sports psychology?",
    a: "It depends on what you do and where you work. The title 'psychologist' is legally protected in US states and requires a doctoral degree plus state licensure. Mental performance consultants who focus on performance enhancement rather than clinical treatment typically do not need a psychology license, though the CMPC credential is the field's recognized standard. If you plan to diagnose or treat mental health conditions, licensure is required."
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://sportsperformancepsychology.com/careers/#webpage",
      "url": "https://sportsperformancepsychology.com/careers/",
      "name": "Sports Psychology Jobs: Roles, Employers & Outlook",
      "description": "Explore sports psychology jobs: common roles, where sports psychologists work, employers hiring now, salary ranges, and career outlook.",
      "isPartOf": { "@id": "https://sportsperformancepsychology.com/#website" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sportsperformancepsychology.com/" },
        { "@type": "ListItem", "position": 2, "name": "Careers", "item": "https://sportsperformancepsychology.com/careers/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};
---
<BaseLayout
  title="Sports Psychology Jobs: Roles, Employers & Outlook"
  description="Explore sports psychology jobs: common roles, where sports psychologists work, employers hiring now, salary ranges, and career outlook."
  ogImage="/images/sports-psychology-career-consulting.webp"
>
  <article>

  <!-- Inner hero -->
  <section class="inner-hero">
    <div class="wrap inner-hero-grid">
      <div class="inner-hero-copy">
        <p class="crumbs"><a href="/">Home</a> &rsaquo; Careers</p>
        <h1>Sports Psychology <span class="accent">Career &amp; Salary Guides</span></h1>
        <p class="lead">Explore career paths, job roles, salary data, and job outlook for sports psychologists and performance professionals in the US.</p>
        <div class="hero-ctas">
          <a class="btn btn-red" href="#career-paths">Explore Careers <Fragment set:html={arrow} /></a>
          <a class="btn btn-outline" href="#salary">Salary Guide</a>
        </div>
      </div>
    </div>
    <div class="hero-media" aria-hidden="true">
      <img class="photo" src="/images/sports-psychology-career-consulting.webp" alt="Sports psychology consultant talking with an athlete on the running track" width="1672" height="941" fetchpriority="high" style="object-position: 50% 40%;" />
      <svg class="hero-curve" viewBox="0 0 500 600" preserveAspectRatio="none">
        <path d="M100,0 C42,150 42,450 100,600" fill="none" stroke="#D62828" stroke-width="10"/>
      </svg>
    </div>
  </section>

  <!-- Quick strip -->
  <div class="quick-strip">
    <div class="wrap">
      <div class="quick-grid">
        <a class="quick-item" href="#career-paths"><Fragment set:html={briefIcon} /><span>Job Roles</span></a>
        <a class="quick-item" href="#salary"><Fragment set:html={chartIcon} /><span>Salary Data</span></a>
        <a class="quick-item" href="#outlook"><Fragment set:html={trendIcon} /><span>Job Outlook</span></a>
        <a class="quick-item" href="#employers"><Fragment set:html={usersIcon} /><span>Employers</span></a>
      </div>
    </div>
  </div>

  <!-- Intro -->
  <section class="section">
    <div class="wrap">
      <div class="prose">
        <h2>What do sports psychology jobs look like?</h2>
        <p>A career in sports psychology means working at the intersection of mind and performance. Professionals in this field help athletes manage pressure, build confidence, stay focused, and return stronger from setbacks. The field has grown well beyond elite sport: today's practitioners work in colleges, academies, private practice, healthcare, the military, and corporate performance settings.</p>
        <p>Most applied roles require at least a master's degree in sports psychology or a related field, and many practitioners hold the <a href="/degrees/certification/">CMPC certification</a>. If you are still choosing your education path, start with our <a href="/degrees/">degree guides</a>, which compare bachelor's, master's, and doctoral routes into the field.</p>
      </div>
    </div>
  </section>

  <!-- Career paths -->
  <section class="section soft" id="career-paths">
    <div class="wrap">
      <div class="section-head">
        <h2>What career paths exist in sports psychology?</h2>
        <p>Common job roles, what they do, and where they work.</p>
      </div>
      <div class="icon-card-grid">
        <article class="icon-card" id="sport-psychologist">
          <span class="icon-disc"><Fragment set:html={usersIcon} /></span>
          <h3>Sport Psychologist</h3>
          <p>Work directly with athletes to build mental skills and performance strategies, from youth competitors to professionals. Licensed sport psychologists can also address mental health concerns that affect performance.</p>
          <p>Typical settings include collegiate athletic departments, professional teams, Olympic programs, and private practice. A doctoral degree plus state licensure is usually required to use the psychologist title.</p>
        </article>
        <article class="icon-card" id="performance-consultant">
          <span class="icon-disc"><Fragment set:html={briefIcon} /></span>
          <h3>Performance Consultant</h3>
          <p>Help teams and individual athletes improve focus, confidence, and consistency through mental skills training. Consultants often work across multiple teams or sports on a contract basis.</p>
          <p>This is the most common applied role for master's-level graduates. The CMPC credential is the recognized standard, and many consultants build a mix of team contracts, individual clients, and workshops.</p>
        </article>
        <article class="icon-card" id="research-academia">
          <span class="icon-disc"><Fragment set:html={bookIcon} /></span>
          <h3>Research &amp; Academia</h3>
          <p>Teach the next generation of practitioners and advance the science of performance through research. Academic roles combine teaching, publishing, and often applied consulting.</p>
          <p>University faculty positions typically require a PhD. Researchers also work in sport institutes, governing bodies, and organizations studying human performance.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Salary -->
  <section class="section" id="salary">
    <div class="wrap">
      <div class="prose">
        <h2>How much do sports psychologists earn in the US?</h2>
        <p>Salary data for sports psychology comes from job aggregators and self-reported surveys rather than a single official source, so figures vary. The numbers below are reported ranges from named sources, and individual pay depends on education, experience, setting, and location. No figure here is a guarantee of what you will earn.</p>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col">Role</th>
                <th scope="col">Typical Reported Range</th>
                <th scope="col">Source and Notes</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Sport Psychologist</th>
                <td>$66,500 - $117,000 per year</td>
                <td>ZipRecruiter, October 2026 (25th to 75th percentile; average reported $92,813)</td>
              </tr>
              <tr>
                <th scope="row">Performance Consultant and related non-clinical roles</th>
                <td>$49,000 - $103,000 per year</td>
                <td>Payscale (average reported near $75,000)</td>
              </tr>
              <tr>
                <th scope="row">Top earners (90th percentile)</th>
                <td>$146,000+ per year</td>
                <td>ZipRecruiter, October 2026; typically experienced consultants with elite clientele</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="table-note">The US Bureau of Labor Statistics does not publish separate salary data for sport psychologists. Figures above reflect aggregator data at the time stated and change over time.</p>

        <h2 id="outlook">What is the job outlook?</h2>
        <p>Interest in mental performance has grown across sport. Collegiate athletic departments increasingly employ full-time mental performance staff, professional organizations invest in player development teams, and youth academies add psychological support earlier in athlete development. Private consulting continues to grow as athletes at all levels seek individual support.</p>
        <p>That said, the field remains competitive, especially for high-profile team positions. Practitioners who combine strong applied skills with business sense, such as building a private practice or developing workshop programs, tend to have the most options. Because the BLS does not track sport psychologists as a separate occupation, treat any specific growth percentage you see online with caution unless it cites a clear methodology.</p>

        <h2 id="employers">Who hires sports psychology professionals?</h2>
        <p>Employers span the full sport ecosystem. College and university athletic departments are among the largest employers of full-time staff. Professional teams and leagues hire consultants for player development. Olympic and national governing bodies employ performance staff around major competitions. Youth sport academies, private training centers, and rehabilitation clinics hire practitioners to support developing and recovering athletes.</p>
        <p>Beyond traditional sport, the military's human performance programs, first-responder organizations, performing arts companies, and corporate leadership programs all hire professionals with mental performance expertise. One well-established example is the U.S. Army's Comprehensive Soldier and Family Fitness (CSF2) program, which employs performance experts to train soldiers' mental skills. Many practitioners blend several of these settings across a career.</p>

        <h2>How do you start a sports psychology career?</h2>
        <p>Breaking into the field takes planning, but the path is well marked. Start with education: a bachelor's degree in psychology, kinesiology, or sport science, followed by a master's program with supervised applied experience. Choose programs whose faculty work in sport settings and whose graduates hold the kinds of jobs you want.</p>
        <p>While studying, accumulate practical hours early. Volunteer with youth teams, assist your university's athletic department, or shadow a working consultant. These experiences build both your skills and your professional network, and they count toward the mentored hours needed for <a href="/degrees/certification/">CMPC certification</a>.</p>
        <p>After graduation, many practitioners begin in part-time or contract roles while building a client base: team consulting, workshops for coaches and parents, and individual sessions with athletes. Joining AASP and attending its annual conference connects you with mentors and employers. Over time, a reputation for reliable, ethical work matters more than any single credential, so treat every early engagement as the foundation of your professional name.</p>
        <p>To understand the education behind these roles, see our <a href="/degrees/">sports psychology degree guides</a>, and learn the core techniques of the profession in our <a href="/mental-skills/">mental skills training guide</a>.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section soft" id="faq">
    <div class="wrap">
      <div class="section-head">
        <h2>Frequently Asked Questions</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div class="faq-answer"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Keep exploring -->
  <section class="section" id="related">
    <div class="wrap explore-wrap">
      <h2>Keep Exploring</h2>
      <div class="explore-links">
        <a href="/degrees/">Sports Psychology Degrees <Fragment set:html={arrow} /></a>
        <a href="/degrees/certification/">CMPC Certification <Fragment set:html={arrow} /></a>
        <a href="/mental-skills/">Mental Skills Training <Fragment set:html={arrow} /></a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </article>
</BaseLayout>
